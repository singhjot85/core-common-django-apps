{% extends "core/base.jinja" %}

{% from "core/components/common/cards.jinja" import stat_card, card, telemetry_strip %}
{% from "core/components/common/buttons.jinja" import button %}
{% from "core/components/common/icons.jinja" import icon %}
{% from "core/components/common/badges.jinja" import badge %}
{% from "core/components/feedback/modals.jinja" import modal %}
{% from "core/components/common/forms.jinja" import input %}
{% from "crm/components/customer_table.jinja" import customer_table %}
{% from "tenants/components/tenant_card.jinja" import tenant_card %}
{% block title %}
    {{ page_label or (current_tenant.label if current_tenant else 'Enterprise Dashboard') }} | Sample Project
{% endblock title %}
{% block content %}
    {# Extract tenant domain and public_id cleanly #}
    {% set tenant_label = (current_tenant.label or current_tenant.name or 'Active Tenant') if current_tenant else 'Enterprise' %}
    {% set tenant_public_id = (current_tenant.public_id or current_tenant.id or '') if current_tenant else '' %}
    {% set tenant_domain = (current_tenant.primary_domain.domain if (current_tenant and current_tenant.primary_domain and current_tenant.primary_domain.domain) else (current_tenant.primary_domain if (current_tenant and current_tenant.primary_domain is string) else (current_tenant.domain if (current_tenant and current_tenant.domain) else ((current_tenant.schema_name ~ '.coreplatform.internal') if (current_tenant and current_tenant.schema_name) else 'acme.coreplatform.internal')))) %}
    {% set tenant_schema = (current_tenant.schema_name if current_tenant else 'acme_prod') %}
    <!-- Sub-Header & Quick Actions Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-md border-b pb-md mb-lg">
        <div>
            <div class="flex items-center gap-sm flex-wrap">
                <h1>Enterprise Overview</h1>
                {% if current_tenant %}
                    <span class="badge badge-primary">{{ tenant_label }}</span>
                    {% if tenant_public_id %}
                        <span class="badge badge-info font-family-mono font-size-xs">{{ tenant_public_id }}</span>
                    {% endif %}
                {% endif %}
            </div>
            <p class="text-muted mb-0 font-size-sm mt-xs">
                Primary Domain:
                <code class="bg-surface-sunken px-sm py-xs radius-sm font-size-xs text-primary font-family-mono">
                    {{ tenant_domain }}
                </code>
            </p>
        </div>
        <div class="flex items-center gap-sm flex-wrap">
            {{ button(label="Create Invoice", icon=icon("receipt", size=18) , variant="outline") }}
            {{ button(label="New Customer", icon=icon("person_add", size=18) , variant="primary", attrs={"data-modal-target": "create_customer_modal"}) }}
        </div>
    </div>
    <!-- KPI Metric Cards (4-column Grid) -->
    <div class="grid grid-cols-4 gap-md mb-lg">
        {{ stat_card("Active Customers", total_customers or (customers|length if customers else 142) , icon=icon("groups", size=24), trend="+12.4%", trend_variant="success", subtext="vs last mo") }}
        {{ stat_card("Pending Invoices", "$18,450" if pending_invoices else "$0", icon=icon("receipt_long", size=24) , trend=(pending_invoices ~ " Pending") if pending_invoices else "0 Pending", trend_variant="warning", subtext="action needed") }}
        {{ stat_card("Draft Invoices", draft_invoices or 3, icon=icon("edit_document", size=24) , subtext="Unissued ($4,200 val)") }}
        {{ stat_card("Tenant MRR", mrr_amount or "$42.8k", icon=icon("payments", size=24) , trend=mrr_growth or "+5.8%", trend_variant="success", subtext="99.2% coll.") }}
    </div>
    {% if current_tenant %}
        <div class="mb-lg">
            <div class="mb-sm">
                <h2>Active Organization</h2>
            </div>
            {{ tenant_card(current_tenant) }}
        </div>
    {% endif %}
    <!-- Recent Customers Section -->
    <div class="mb-lg">
        <div class="flex items-center justify-between gap-sm mb-sm flex-wrap">
            <div>
                <h2>Recent Customers</h2>
            </div>
            <div class="flex items-center gap-sm">
                {{ button(label="Export", icon=icon("download", size=18) , variant="outline", size="sm") }}
            </div>
        </div>
        {{ customer_table(customers=customers) }}
    </div>
    <!-- Tenant Audit Log / System Telemetry Strip -->
    <div class="mb-lg">
        {{ telemetry_strip(title='PostgreSQL Search Path: set tenant_schema to "' ~ tenant_schema ~ '"' ~ ((' (ID: ' ~ tenant_public_id ~ ')') if tenant_public_id else ''),
        subtitle='Isolation verification hash: 0x8f2a99d0e1 · Query overhead: 0.12ms',
        status_badge="CELERY QUEUE READY",
        sync_status="SYNC OK"
        ) }}
    </div>
    <!-- Create Customer Modal Dialog -->
    {% call modal(modal_id="create_customer_modal", title="Register New Customer", subtitle="Create customer account record inside tenant scope") %}
        <form method="post" id="create_customer_form">
            {{ csrf_input }}
            {{ input(name="full_name", label="Full Name / Company Name", placeholder="e.g. Acme Innovations Ltd", required=True) }}
            {{ input(name="email", type="email", label="Primary Email Address", placeholder="ops@example.com", required=True) }}
            {{ input(name="phone", label="Primary Phone Number", placeholder="+1 555-0199") }}
            <div class="flex justify-end gap-sm mt-md">
                {{ button(label="Cancel", variant="outline", size="sm", attrs={"data-modal-close": "create_customer_modal"}) }}
                {{ button(label="Save Customer", variant="primary", size="sm", type="submit") }}
            </div>
        </form>
    {% endcall %}
{% endblock content %}
