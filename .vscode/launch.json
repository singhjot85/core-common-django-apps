    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django Container",
            "type": "python",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 2253
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/backend/core-common-django-apps/",
                    "remoteRoot": "/backend"
                }
            ],
            "justMyCode": false
        },
        {
            "name": "Celery Container",
            "type": "python",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 2254
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/backend",
                    "remoteRoot": "/backend"
                }
            ],
            "justMyCode": false
        }
    ]
}
