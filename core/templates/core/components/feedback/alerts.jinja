{# Alerts & Flash Message Macros #}
{% from "core/components/common/icons.jinja" import icon %}
{% macro alert(message=None, variant="info", dismissible=True, extra_classes="") %}
    <div class="alert alert-{{ variant }}{% if extra_classes %} {{ extra_classes }}{% endif %}"
         role="alert">
        <div>
            {% if message %}{{ message }}{% endif %}
            {% if caller %}{{ caller() }}{% endif %}
        </div>
        {% if dismissible %}
            <button type="button"
                    class="btn btn-sm btn-outline alert-dismiss-btn"
                    data-alert-dismiss
                    aria-label="Close">{{ icon("close", size=18) }}</button>
        {% endif %}
    </div>
{% endmacro %}
{% macro message_list(messages) %}
    {% if messages %}
        <div class="messages-container mb-md">
            {% for msg in messages %}
                {% if msg %}
                    {% set msg_text = msg.message if msg.message is defined else msg|string %}
                    {% set raw_tag = (msg.tags if msg.tags is defined else (msg.tag if msg.tag is defined else "info"))|string %}
                    {% set tag = "danger" if "error" in raw_tag else ("warning" if "warning" in raw_tag else ("success" if "success" in raw_tag else "info")) %}
                    {{ alert(message=msg_text, variant=tag) }}
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
{% endmacro %}
