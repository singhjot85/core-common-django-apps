{# Modals Macro Component #}
{% from "core/components/common/icons.jinja" import icon %}
{% macro modal(id=None, modal_id=None, title=None, subtitle=None, footer_content=None, max_width="500px", extra_classes="") %}
    {% set target_id = modal_id or id or "modal" %}
    <div class="modal-backdrop{% if extra_classes %} {{ extra_classes }}{% endif %}"
         id="{{ target_id }}"
         role="dialog"
         aria-modal="true"
         aria-labelledby="{{ target_id }}_title">
        <div class="modal-dialog">
            {% if title or subtitle %}
                <div class="card-header">
                    <div>
                        {% if title %}<h3 id="{{ target_id }}_title" class="card-title">{{ title }}</h3>{% endif %}
                        {% if subtitle %}<p class="text-muted mb-0 font-size-xs">{{ subtitle }}</p>{% endif %}
                    </div>
                    <button type="button"
                            class="btn btn-sm btn-outline alert-dismiss-btn"
                            data-modal-close="{{ target_id }}"
                            aria-label="Close">{{ icon("close", size=18) }}</button>
                </div>
            {% endif %}
            <div class="card-body">
                {% if caller %}{{ caller() }}{% endif %}
            </div>
            {% if footer_content %}<div class="card-footer">{{ footer_content|safe }}</div>{% endif %}
        </div>
    </div>
{% endmacro %}
