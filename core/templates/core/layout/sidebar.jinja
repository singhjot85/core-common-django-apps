{# Global Sidebar #}
{% from "core/components/common/icons.jinja" import icon %}

<aside class="app-sidebar">
  <div class="sidebar-header" style="padding: var(--spacing-lg); border-bottom: 1px solid var(--color-border);">
    <h2 style="font-size: var(--font-size-lg);">
      {% block sidebar_brand %}Core Dashboard{% endblock %}
    </h2>
    {% if request and request.tenant %}
      <div class="badge badge-primary mt-sm">{{ request.tenant.name if request.tenant.name else request.tenant.schema_name }}</div>
    {% endif %}
  </div>

  <nav class="sidebar-nav" style="padding: var(--spacing-md); display: flex; flex-direction: column; gap: var(--spacing-xs);">
    {% block sidebar_nav %}
      <a href="/" class="btn btn-outline justify-start w-full" style="border: none;">
        {{ icon("home", size=20) }}
        <span>Home</span>
      </a>
      <a href="/crm/" class="btn btn-outline justify-start w-full" style="border: none;">
        {{ icon("group", size=20) }}
        <span>Customers</span>
      </a>
      <a href="/tenants/" class="btn btn-outline justify-start w-full" style="border: none;">
        {{ icon("domain", size=20) }}
        <span>Organizations</span>
      </a>
      <a href="/invoices/" class="btn btn-outline justify-start w-full" style="border: none;">
        {{ icon("receipt_long", size=20) }}
        <span>Invoices</span>
      </a>
    {% endblock %}
  </nav>
</aside>
