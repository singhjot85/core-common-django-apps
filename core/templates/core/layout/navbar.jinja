{# Global Navbar #}
{% from "core/components/common/icons.jinja" import icon %}

<header class="app-header">
  <div class="flex items-center gap-md">
    <button type="button" class="btn btn-sm btn-outline mobile-menu-toggle" data-sidebar-mobile-toggle aria-label="Toggle mobile navigation">
      {{ icon("menu", size=20) }}
    </button>
    <div class="brand-title">
      <strong>{% block page_label %}{{ page_label or PROJECT_LABEL or 'Core Application' }}{% endblock page_label %}</strong>
    </div>
  </div>

  <div class="flex items-center gap-md">
    {% block header_actions %}{% endblock %}

    <!-- Theme Toggle Switcher -->
    <button type="button" class="btn btn-sm btn-outline theme-toggle-btn" data-theme-toggle aria-label="Toggle dark mode" title="Toggle theme">
      <span class="theme-icon-dark">{{ icon("dark_mode", size=18) }}</span>
      <span class="theme-icon-light" style="display: none;">{{ icon("light_mode", size=18) }}</span>
    </button>

    {% block header_user %}
      {% if request and request.user and request.user.is_authenticated %}
        <div class="flex items-center gap-xs text-muted" style="font-size: var(--font-size-sm);">
          {{ icon("account_circle", size=18) }}
          <span>{{ request.user.get_username() if request.user.get_username is callable else request.user.username }}</span>
        </div>
      {% endif %}
    {% endblock %}
  </div>
</header>
