{# Global Navbar #}

<header class="app-header">
  <div class="flex items-center gap-md">
    <button class="btn btn-sm btn-outline mobile-menu-toggle" style="display: none;" onclick="document.querySelector('.app-sidebar').classList.toggle('open')">
      ☰
    </button>
    <div class="brand-title">
      <strong>{% block header_brand %}{{ PROJECT_LABEL or 'Core Application' }}{% endblock %}</strong>
    </div>
  </div>

  <div class="flex items-center gap-md">
    {% block header_user %}
      {% if request and request.user and request.user.is_authenticated %}
        <span class="text-muted" style="font-size: var(--font-size-sm);">{{ request.user.get_username() if request.user.get_username is callable else request.user.username }}</span>
      {% endif %}
    {% endblock %}
    {% block header_actions %}{% endblock %}
  </div>
</header>
