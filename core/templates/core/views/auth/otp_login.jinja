{# Phone & Email OTP Login / Signup Component #}
{% set labels = resolve_labels("users_template_label", labels) if resolve_labels is defined else (labels or {}) %}
{% from "core/components/common/buttons.jinja" import button %}
{% from "core/components/common/icons.jinja" import icon %}
{% from "core/forms/form_field_text.jinja" import form_field_text %}
{% from "core/forms/form_field_email.jinja" import form_field_email %}
{% from "core/forms/form_field_otp.jinja" import form_field_otp %}
<div class="auth-method-card" id="auth_method_otp_container">
    <!-- Top Mode Switcher: Sign In vs Sign Up (Default: Sign In) -->
    <div class="auth-tabs" role="tablist">
        <button type="button"
                class="auth-tab-btn active"
                data-otp-tab="signin"
                data-auth-tab="signin"
                role="tab"
                aria-selected="true"
                aria-controls="otp_section_signin">
            {{ icon("login", size=18) }}
            <span>{{ labels.sign_in }}</span>
        </button>
        <button type="button"
                class="auth-tab-btn"
                data-otp-tab="signup"
                data-auth-tab="signup"
                role="tab"
                aria-selected="false"
                aria-controls="otp_section_signup">
            {{ icon("person_add", size=18) }}
            <span>{{ labels.create_account }}</span>
        </button>
    </div>
    <div class="auth-card-body">
        <!-- ================= SECTION: OTP SIGN IN ================= -->
        <div id="otp_section_signin" data-otp-tab-content="signin">
            <form method="post"
                  action="{{ otp_verify_action|default('/api/users/v1/auth/otp/verify/') }}"
                  id="form_otp_login"
                  data-auth-api="otp-login"
                  data-redirect-url="{{ redirect_url|default(landing_page_url|default('/') ) }}">
                {{ csrf_input }}
                <input type="hidden" name="auth_flow" value="otp">
                <!-- Channel Identifier Input & Send OTP Button -->
                <div class="form-group mb-md">
                    <label class="form-label" for="otp_login_identifier">
                        {{ labels.phone_or_email }} <span class="text-danger">*</span>
                    </label>
                    <div class="input-action-group">
                        <input type="text"
                               id="otp_login_identifier"
                               name="identifier"
                               class="form-control"
                               placeholder="+1 (555) 000-0000 or user@example.com"
                               required>
                        <button type="button"
                                id="btn_send_login_otp"
                                class="btn btn-outline btn-md"
                                data-action-send-otp
                                data-target-input="#otp_login_identifier"
                                disabled>{{ labels.send_code }}</button>
                    </div>
                </div>
                <!-- OTP 6-Digit Challenge Section -->
                <div id="otp_challenge_wrapper" class="mb-lg" style="display: none">
                    {{ form_field_otp("otp_code", label=labels.otp_code, digits=6, required=True) }}
                    <p class="font-size-xs text-muted mt-xs flex justify-between">
                        <span>Click 1st box to paste from clipboard</span>
                        <a href="#"
                           id="link_resend_otp"
                           class="text-primary hover:underline"
                           style="display: none">{{ labels.resend_code }}</a>
                    </p>
                </div>
                <!-- Warning Banner: Remaining Attempts & Lockout -->
                <div class="auth-attempts-warning mb-md"
                     id="otp_login_attempts_warning"
                     style="display: none"
                     role="alert"
                     aria-live="polite">
                    <span class="material-symbols-outlined font-size-sm">warning</span>
                    <span class="warning-text"></span>
                </div>
                <!-- Verify & Submit Button: Disabled until 6 digits entered -->
                {{ button(label=labels.verify_and_sign_in, variant="primary", type="submit", extra_classes="w-full", id="btn_otp_submit", disabled=True) }}
            </form>
        </div>
        <!-- ================= SECTION: OTP SIGN UP ================= -->
        <div id="otp_section_signup"
             data-otp-tab-content="signup"
             style="display: none">
            <form method="post"
                  action="{{ otp_verify_action|default(signup_action|default('/api/users/v1/auth/otp/verify/') ) }}"
                  id="form_otp_signup"
                  data-auth-api="otp-signup"
                  data-redirect-url="{{ redirect_url|default(landing_page_url|default('/') ) }}">
                {{ csrf_input }}
                <input type="hidden" name="auth_flow" value="otp_signup">
                <div class="grid grid-cols-2 gap-md mb-md">
                    {{ form_field_text("first_name", label=labels.first_name, placeholder="Alex", required=True) }}
                    {{ form_field_text("last_name", label=labels.last_name, placeholder="Morgan", required=True) }}
                </div>
                <!-- Phone Verification with Send OTP -->
                <div class="form-group mb-md">
                    <label class="form-label" for="otp_signup_phone">
                        {{ labels.phone_number }} <span class="text-danger">*</span>
                    </label>
                    <div class="input-action-group">
                        <input type="tel"
                               id="otp_signup_phone"
                               name="phone_number"
                               class="form-control"
                               placeholder="+1 (555) 000-0000"
                               required>
                        <button type="button"
                                id="btn_send_signup_otp"
                                class="btn btn-outline btn-md"
                                data-action-send-otp
                                data-target-input="#otp_signup_phone"
                                disabled>{{ labels.verify_phone }}</button>
                    </div>
                </div>
                <!-- Signup OTP Input (Appears on OTP dispatch) -->
                <div id="otp_signup_challenge_wrapper" class="mb-md" style="display: none">
                    {{ form_field_otp("signup_otp_code", label=labels.otp_code, digits=6, required=True) }}
                </div>
                {{ form_field_email("email", label=labels.email, placeholder="alex@example.com", required=False) }}
                <div class="mt-lg">
                    {{ button(label=labels.create_account, variant="primary", type="submit", extra_classes="w-full", id="btn_otp_signup_submit", disabled=True) }}
                </div>
            </form>
        </div>
    </div>
</div>
