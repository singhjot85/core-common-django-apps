{# core_login_template.jinja: Gateway login template with method switcher (Password vs OTP) #}
{% set labels = resolve_labels(labels) if resolve_labels is defined else (labels or {}) %}
{% from "core/components/common/icons.jinja" import icon %}
{% from "core/components/feedback/alerts.jinja" import message_list %}
<div class="auth-shell">
    <div class="auth-main">
        <div class="auth-container">
            <!-- Brand Identity Header -->
            <div class="auth-brand">
                <div class="auth-brand-header">
                    <div class="brand-icon-wrapper">{{ icon("rocket_launch", size=26, extra_classes="text-primary") }}</div>
                    <h1 class="auth-brand-title">{{ PROJECT_LABEL or 'Core Console' }}</h1>
                </div>
                <p class="auth-brand-subtitle">{{ labels.subtitle }}</p>
            </div>
            <!-- Master Authentication Card -->
            <div class="auth-card">
                <!-- Method Switcher: Username & Password vs OTP Code -->
                <div class="auth-method-switcher" role="tablist">
                    <button type="button"
                            class="auth-method-btn active"
                            data-auth-method="username"
                            role="tab"
                            aria-selected="true"
                            aria-controls="auth_method_username_wrapper">
                        {{ icon("password", size=16) }}
                        <span>{{ labels.password_login }}</span>
                    </button>
                    <button type="button"
                            class="auth-method-btn"
                            data-auth-method="otp"
                            role="tab"
                            aria-selected="false"
                            aria-controls="auth_method_otp_wrapper">
                        {{ icon("pin", size=16) }}
                        <span>{{ labels.otp_login }}</span>
                    </button>
                </div>
                <!-- Flash Messages & Dynamic Snack Container -->
                {% if messages %}{{ message_list(messages) }}{% endif %}
                <div id="auth_toast_container"
                     class="auth-toast-container"
                     aria-live="polite"></div>
                <!-- Method 1: Username & Password Flow -->
                <div id="auth_method_username_wrapper" data-auth-method-content="username">
                    {% include "core/views/auth/username_login.jinja" %}

                </div>
                <!-- Method 2: OTP Flow -->
                <div id="auth_method_otp_wrapper"
                     data-auth-method-content="otp"
                     style="display: none">
                    {% include "core/views/auth/otp_login.jinja" %}

                </div>
            </div>
            <!-- Footer Links -->
            <div class="auth-footer text-center mt-lg radius-lg border">
                <div class="flex items-center justify-center gap-md font-size-xs text-muted">
                    <a href="{{ privacy_url|default('#privacy') }}"
                       class="text-muted hover:text-primary">{{ labels.privacy_policy }}</a>
                    <a href="{{ terms_url|default('#terms') }}"
                       class="text-muted hover:text-primary">{{ labels.terms_of_service }}</a>
                    <a href="{{ status_url|default('#status') }}"
                       class="text-muted hover:text-primary">{{ labels.platform_status }}</a>
                </div>
            </div>
        </div>
    </div>
</div>
