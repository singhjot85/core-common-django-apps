<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}Core Framework{% endblock %}</title>

  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <!-- Google Material Symbols Outlined -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

  <!-- Core Design Tokens & Styles -->
  <link rel="stylesheet" href="{{ static('core/css/variables.css') }}">
  <link rel="stylesheet" href="{{ static('core/css/base.css') }}">
  <link rel="stylesheet" href="{{ static('core/css/components.css') }}">

  <!-- Theme Preference Script (FOUC Prevention) -->
  <script>
    (function () {
      try {
        var theme = localStorage.getItem('core_theme') || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme) document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>

  {% block extra_head %}{% endblock %}
</head>
<body>
  <div class="app-shell">

    <!-- Sidebar -->
    {% block sidebar %}
      {% include "core/layout/sidebar.jinja" %}
    {% endblock %}

    <!-- Main Content Area -->
    <div class="app-main">
      <!-- Top Navbar -->
      {% block header %}
        {% include "core/layout/navbar.jinja" %}
      {% endblock %}

      <!-- Content Container -->
      <main class="app-content">
        <!-- Messages / Alerts -->
        {% block messages %}
          {% if messages %}
            {% from "core/components/feedback/alerts.jinja" import message_list %}
            {{ message_list(messages) }}
          {% endif %}
        {% endblock %}

        <!-- Main View Content -->
        {% block content %}{% endblock %}
      </main>

      <!-- Footer -->
      {% block footer %}
        {% include "core/layout/footer.jinja" %}
      {% endblock %}
    </div>
  </div>

  <!-- Core JavaScript Framework & Services -->
  <script src="{{ static('core/js/core.js') }}"></script>
  <script src="{{ static('core/js/service.js') }}"></script>
  {% block extra_scripts %}{% endblock %}
</body>
</html>
