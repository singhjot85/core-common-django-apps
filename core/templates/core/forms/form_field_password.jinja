{# Form Field: Password #}
{% from "core/components/common/icons.jinja" import icon %}
{% macro form_field_password(name, label=None, value="", placeholder="••••••••", required=False, error=None, hint=None, extra_classes="") %}
    <div class="form-group{% if extra_classes %} {{ extra_classes }}{% endif %}">
        {% if label %}
            <label class="form-label" for="id_{{ name }}">
                {{ label }}
                {% if required %}<span class="text-danger">*</span>{% endif %}
            </label>
        {% endif %}
        <div class="input-password-wrapper">
            <input type="password"
                   name="{{ name }}"
                   id="id_{{ name }}"
                   value="{{ value }}"
                   placeholder="{{ placeholder }}"
                   class="form-control pr-10{% if error %} is-invalid{% endif %}"
                   {% if required %}required{% endif %}
                   {{ kwargs|xmlattr }}>
            <button type="button"
                    class="btn-password-toggle"
                    data-password-toggle="id_{{ name }}"
                    aria-label="Toggle password visibility"
                    tabindex="-1">
                <span class="password-icon-show">{{ icon("visibility", size=18) }}</span>
                <span class="password-icon-hide">{{ icon("visibility_off", size=18) }}</span>
            </button>
        </div>
        {% if hint %}<span class="form-hint">{{ hint }}</span>{% endif %}
        {% if error %}<span class="form-error">{{ error }}</span>{% endif %}
    </div>
{% endmacro %}
