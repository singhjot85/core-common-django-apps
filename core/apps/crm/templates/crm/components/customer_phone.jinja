{# Customer Phone Management Macro #}
{% from "core/components/common/badges.jinja" import badge %}
{% from "core/components/common/buttons.jinja" import button %}
{% from "core/components/common/icons.jinja" import icon %}
{% macro customer_phone_list(phones=[], extra_classes="") %}
    <div class="customer-phone-list{% if extra_classes %} {{ extra_classes }}{% endif %}">
        {% if phones %}
            <div class="flex flex-col gap-xs">
                {% for p in phones %}
                    <div class="flex items-center justify-between phone-list-item">
                        <div class="flex items-center gap-sm">
                            {{ icon("call", size=18) }}
                            <strong>{{ p.phone }}</strong>
                            {% if p.is_primary %}{{ badge("Primary", variant="success") }}{% endif %}
                        </div>
                        <span class="text-muted font-size-xs">{{ p.get_phone_type_display() if p.get_phone_type_display is callable else (p.phone_type or 'General') }}</span>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-muted mb-0">No phone numbers on record.</p>
        {% endif %}
    </div>
{% endmacro %}
